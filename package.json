{
  "name": "fishai",
  "private": false,
  "version": "0.1.0",
  "description": "A bot that plays Canadian Fish (Literature), and the simulation lab that measures whether any play style is actually superior.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "sim": "node scripts/simulate.mjs",
    "lab": "node scripts/style-sim.mjs",
    "analyze": "node scripts/style-analyze.mjs",
    "adaptive": "node scripts/adaptive-sim.mjs",
    "adaptive:analyze": "node scripts/adaptive-analyze.mjs",
    "bounded": "node scripts/bounded-sim.mjs",
    "bounded:analyze": "node scripts/bounded-analyze.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
